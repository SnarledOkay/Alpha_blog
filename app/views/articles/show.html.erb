<h1 class="text-center mt-4"><%= @article.title %></h1>
<div class = "container">
    <div class="row justify-content-md-center">
        <div class="col-8 mt-4">
            <div class="card shadow p-3 mb-3 bg-white rounded">
                <h5 class="card-header fst-italic fs-6 text-center">
                    Published by <%= @article.user.username %>
                    <%= link_to gravatar_for(@article.user), user_path(@article.user) %>
                    <% if @article.categories.any? %>
                        <%# Approach 1: use 'each' to iterate through list of categories %>
                        <%# Approach 2: use 'render' to tell Rails to print out every element of list %>
                        <div class="mt-2">
                            <%= render @article.categories %>
                        </div>
                    <% end %>
                </h5>
                <div class="card-body">
                    <div class="card-text">
                        <%= simple_format(@article.description) %>
                    </div>
                    <% if logged_in? && (@article.user == current_user || current_user.admin?) %>
                        <%= link_to "Delete", article_path(@article), class: "btn btn-danger", data:{turbo_method: "delete"}%>
                        <%= link_to "Edit", edit_article_path(@article), class: "btn btn-warning"%>
                    <% end %>
                    <%= link_to "Return", articles_path, class: "btn btn-secondary"%>
                </div>
                <div class="card-footer text-muted">
                    <small>Created <%= time_ago_in_words(@article.created_at) %> ago, last updated <%= time_ago_in_words(@article.updated_at)%> ago</small>
                </div>
            </div>
        </div>
    </div>
</div>