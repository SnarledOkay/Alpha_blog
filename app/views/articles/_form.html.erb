<div class="container">
    <div class="row d-flex justify-content-center">
        <div class="col-10">
            <%= render 'shared/errors',obj:@article %>
            <%= form_with(model: @article,class:"shadow p-3 mb-3 bg-success rounded", local: true, data:{turbo:false}) do |f| %>
                <div class="form-group row mb-2">
                    <%= f.label :title, class: "col-2 col-form-label text-light" %>
                    <div class="col-10">
                        <%= f.text_field :title, class:"form-control shadow rounded p-2", placeholder:"Title of article" %>
                    </div>
                </div>
                <div class = "form-group row mb-4">
                    <%= f.label :description, class: "col-2 col-form-label text-light"%>
                    <div class="col-10">
                        <%= f.text_area :description,rows:10, class:"form-control shadow rounded p-2",placeholder:"Description of article" %>
                    </div>
                </div>
                <div class = "form-group d-flex justify-content-center">
                    <%= f.submit class: "btn btn-warning btn-lg" %>
                </div>
            <% end %>
        </div>
        <div class="text-center">
            <%= link_to 'Cancel and Return to Index', articles_path, class:"btn btn-secondary" %>
        </div>
    </div>
</div>