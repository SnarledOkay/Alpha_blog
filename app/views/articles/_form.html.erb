<% if @article.errors.any? %>
    <h2>Error: registration fails due to the following errors: </h2>
    <ul>
        <% @article.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
        <% end %>
    </ul>
<% end %>

<%# 'form_with scope: :article' gives us an empty textbox%>
<%# However, we want the content to appear if we want to update them %>

<%# We specify that we're working with an instance of model Article %>
<%= form_with(model: @article, local: true, data:{turbo:false}) do |f| %>
    <p>
        <%= f.label :title %><br/>
        <%= f.text_field :title %>
    </p>
    <p>
        <%= f.label :description %><br/>
        <%= f.text_area :description %>
    </p>
    <p>
        <%= f.submit %>
    </p>
<% end %>