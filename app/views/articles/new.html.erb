<h1>Provide info for new article</h1>

<%# Rails keyword is 'articles_path' for URL %>
<%# 'local: true' means that we're calling the request locally instead of remotely through Ajax %>
<%# if using 'form_for' instead of 'form_with', regular POST request is executed %>

<%# We check if any errors has been created and display them on the screen %>
<%# As we render new form when error, instance variable is also carried over as well %>
<% if @article.errors.any? %>
    <h2>Error: registration fails due to the following errors: </h2>
    <ul>
        <% @article.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
        <% end %>
    </ul>
<% end %>

<%# 'text_field' gives a one-line text box, while 'text_area' gives us a bigger box for text input %>
<%= form_with scope: :article, url: articles_path, local: true, data:{turbo:false} do |f| %>
    <p>
        <%= f.label :title %> <br>
        <%= f.text_field :title %>
    </p>

    <p>
        <%= f.label :description %> <br>
        <%= f.text_area :description %>
    </p>
    
    <p>
        <%= f.submit %>
    </p>
<% end %>