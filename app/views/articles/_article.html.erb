<div class = "container">
    <% @articles.each do |article| %>
        <div class="row justify-content-md-center">
            <div class="col-8 mt-4">
                <div class="card shadow p-3 mb-3 bg-white rounded">
                    <h5 class="card-header fst-italic fs-6 text-center">
                        <% if article.user %>
                            Published by <%= link_to article.user.username, user_path(article.user) %>
                        <% end %>
                    </h5>
                    <div class="card-body">
                        <h5 class="card-title">
                            <%= link_to article.title, article_path(article), class: "text-success text-decoration-none"%>
                        </h5>
                        <p class="card-text">
                            <%= truncate(article.description, length: 100) %>
                        </p>
                        <%= link_to "View", article_path(article), class: "btn btn-primary"%>
                        <% if logged_in? && (article.user == current_user || current_user.admin?) %>
                            <%= link_to "Edit", edit_article_path(article), class: "btn btn-warning"%>
                            <%= link_to "Delete", article_path(article), class: "btn btn-danger", data:{turbo_method: "delete", turbo_confirm:"Do you want to delete this article?"}%>
                        <% end %>
                    </div>
                    <div class="card-footer text-muted">
                        <small>Created <%= time_ago_in_words(article.created_at) %> ago, last updated <%= time_ago_in_words(article.updated_at)%> ago</small>
                    </div>
                </div>
            </div>
        </div>
    <% end %>
</div>