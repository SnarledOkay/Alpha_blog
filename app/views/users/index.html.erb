<h1 class="text-center mt-4">List of Active Users</h1>
<div class="flickr_pagination">
    <%= will_paginate @posts, :container => false %>
</div>
<div class = "container">
    <% @users.each do |user| %>
        <div class="row justify-content-md-center">
            <div class="col-8 mt-4">
                <div class="card shadow p-3 mb-3 bg-white rounded">
                    <h5 class="card-header fst-italic fs-6 text-center">
                        <%= link_to user.username, user_path(user) %>
                    </h5>
                    <div class="card-body">
                        <h5 class="card-title">
                            <%= link_to gravatar_for(user,size:150), user %>
                        </h5>   
                        <p class="card-text text-center">
                            <%= user.articles.count %> article(s) published
                        </p>
                        <%= link_to "View Profile", user_path(user), class: "btn btn-primary"%>
                        <%= link_to "Edit Profile", edit_user_path(user), class: "btn btn-warning"%>
                    </div>
                    <div class="card-footer text-muted">
                        <small>Joined <%= time_ago_in_words(user.created_at)%> ago</small>
                    </div>
                </div>
            </div>
        </div>
    <% end %>
</div>
<div class="flickr_pagination">
    <%= will_paginate @posts, :container => false %>
</div>