<div class="container">
    <div class="row d-flex justify-content-center">
        <div class="col-8">
            <%= render 'shared/errors',obj: @user %>
            <%= form_with(model: @user,class:"shadow p-3 mb-3 bg-success rounded", local: true, data:{turbo:false}) do |f| %>
                <div class="form-group row mb-2">
                    <%= f.label :email, class: "col-2 col-form-label text-light" %>
                    <div class="col-10">
                        <%= f.text_field :email, class:"form-control shadow rounded p-2", placeholder:"Enter email" %>
                    </div>
                </div>
                <div class = "form-group row mb-2">
                    <%= f.label :username, class: "col-2 col-form-label text-light"%>
                    <div class="col-10">
                        <%= f.text_field :username, class:"form-control shadow rounded p-2",placeholder:"Enter username" %>
                    </div>
                </div>
                <div class = "form-group row mb-2">
                    <%= f.label :password, class: "col-2 col-form-label text-light"%>
                    <div class="col-10">
                        <%= f.text_field :password, class:"form-control shadow rounded p-2",placeholder:"Enter password" %>
                    </div>
                </div>
                <div class = "form-group row">
                    <%= f.label :password_confirmation, class: "col-2 col-form-label text-light"%>
                    <div class="col-10">
                        <%= f.text_field :password_confirmation, class:"form-control shadow rounded p-2", placeholder: "Confirm your password"%>
                    </div>
                </div>
                <div class = "form-group d-flex justify-content-center">
                    <%= f.submit(@user.new_record? ? "Sign Up" : "Save Changes", class: "btn btn-warning btn-lg") %>
                </div>
            <% end %>
        </div>
        <div class="text-center">
            <%= link_to 'Cancel and Return to Home page', root_path, class:"btn btn-secondary" %>
        </div>
    </div>
</div>