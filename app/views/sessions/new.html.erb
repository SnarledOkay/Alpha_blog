<h1 class="text-center mt-4"> Log In </h1>

<div class="container">
    <div class="row d-flex justify-content-center">
        <div class="col-6">
            <%= form_with(scope: :session, url: login_path, class:"shadow p-3 mb-3 bg-success rounded", local: true, data:{turbo:false}) do |f| %>
                <div class="form-group row mb-3">
                    <%= f.label :email, class: "col-2 col-form-label text-light" %>
                    <div class="col-10">
                        <%= f.text_field :email, class:"form-control shadow rounded p-2", placeholder:"Enter email" %>
                    </div>
                </div>
                <div class = "form-group row mb-3">
                    <%= f.label :password, class: "col-2 col-form-label text-light"%>
                    <div class="col-10">
                        <%= f.text_field :password, class:"form-control shadow rounded p-2",placeholder:"Enter password" %>
                    </div>
                </div>
                <div class = "form-group d-flex justify-content-center">
                    <%= f.submit "Log In", class: "btn btn-warning btn-lg" %>
                </div>
            <% end %>
        </div>
        <div class="text-center">
            <%= link_to 'Cancel and Return to Home page', root_path, class:"btn btn-secondary" %>
        </div>
    </div>
</div>