<nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container-fluid">
        <%# <a class="navbar-brand" id="logo" href="#">Alpha Blog</a> %>
        <%= link_to "Alpha Blog", root_path, class: "navbar-brand",id: "logo" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item">
              <%# <a class="nav-link active" aria-current="page" href="#">Home</a> %>
              <%= link_to "Articles", articles_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Users", users_path, class:"nav-link" %>
            </li> 
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                Actions
              </a>
              <div class="dropdown-menu">
                <%= link_to "Articles index", articles_path, class:"dropdown-item" %>
                <% if logged_in? %>
                  <%= link_to "Publish an article", new_article_path, class:"dropdown-item" %>
                <% end %>
              </div>
            </li>
            <% if logged_in? %>
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                  <%= current_user.admin? ? "Admin" : "User" %> [<%= current_user.username %>]
                </a>
                <div class="dropdown-menu">
                  <%= link_to "View Profile", user_path(current_user), class:"dropdown-item" %>
                  <%= link_to "Edit Profile", edit_user_path(current_user), class:"dropdown-item" %>
                  <div class="dropdown-divider"></div>
                  <%= link_to "Log Out", logout_path, class:"dropdown-item text-warning",data:{turbo_method: :delete} %>
                  <div class="dropdown-divider"></div>
                  <%= link_to "Delete Account", user_path(current_user), class:"dropdown-item text-danger fw-bold", data:{turbo_method: :delete,turbo_confirm: "Are you sure you want to delete account?"}%>
                </div>
              </li>
            <% else %>
              <li class="nav-item">
                <%= link_to "Log in", login_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Sign up", sign_up_path, class: "nav-link" %>
              </li>
            <% end %>
          </ul>
          <form class="d-flex" role="search">
            <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search"/>
            <button class="btn btn-outline-success" type="submit">Search</button>
          </form>
        </div>
    </div>
</nav>